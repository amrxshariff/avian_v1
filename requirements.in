#   uv pip compile requirements-dev.in --universal --python-version 3.11 -o requirements-dev.txt
#
# Membership is derived from the code, not from memory:
#   python -m tools.import_closure app src.linkedin src.ingestion src.classify_pipeline src.embeddings src.projection_3d src.graph src.centrality
